<resources>
    <style name="Theme.Unibus" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <!-- Fontes removidas pois o arquivo fisico nao existe no projeto -->
        <item name="android:colorAccent">@color/unibus_blue</item>
        <item name="colorPrimary">@color/unibus_blue</item>
        <item name="colorPrimaryDark">@color/unibus_blue_dark</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/background_beige</item>
    </style>
    <!-- Estilo para os popups de finalização de rota -->
    <style name="TemaPopup" parent="Theme.AppCompat.Light.Dialog">
        <!-- Remove a barra de título (a barra preta com o nome Unibus) -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <!-- Deixa o fundo em volta do CardView transparente -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- Remove o sombreamento escuro padrão do fundo se desejar -->
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
