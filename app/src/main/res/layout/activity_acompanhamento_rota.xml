<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_beige">

    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/unibus_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/logo_unibus_texto"
        app:layout_constraintBottom_toBottomOf="@+id/btnVoltar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnVoltar" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardMapaContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="0dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@+id/barraMapaAluno"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnVoltar">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgMapaAluno"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/mapa_rota_motorista"
                app:srcCompat="@drawable/tela_mapa_motorista" />

            <LinearLayout
                android:id="@+id/barraPesquisaMapaAluno"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_search_bar"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <EditText
                    android:id="@+id/etPesquisaPontosAluno"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Pesquise pontos"
                    android:inputType="text"
                    android:textColor="@color/unibus_blue"
                    android:textColorHint="#801A5F8A"
                    android:textSize="13sp" 
        android:fontFamily="@font/josefin_sans"/>

                <ImageView
                    android:id="@+id/btnPesquisarPontosAluno"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:src="@drawable/ic_search"
                    app:tint="@color/unibus_blue" />
            </LinearLayout>


            <View
                android:id="@+id/pontoMapa1"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="78dp"
                android:layout_marginTop="62dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/pontoMapa2"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="110dp"
                android:layout_marginTop="162dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/pontoMapa3"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="end"
                android:layout_marginTop="175dp"
                android:layout_marginEnd="4dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/pontoMapa4"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="202dp"
                android:layout_marginTop="364dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/pontoMapa5"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="end"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="0dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/barraMapaAluno"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginHorizontal="8dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/menuInferior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/btnPosicaoNaRotaAluno"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/unibus_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Posição na rota"
                android:textColor="@color/unibus_blue"
                android:textSize="12sp"
                android:textStyle="bold" 
        android:fontFamily="@font/josefin_sans"
        android:includeFontPadding="true"/>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:alpha="0.35"
            android:background="@color/unibus_blue" />

        <LinearLayout
            android:id="@+id/btnQrCodeAluno"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_qr_code"
                app:tint="@color/unibus_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="QR code"
                android:textColor="@color/unibus_blue"
                android:textSize="12sp"
                android:textStyle="bold" 
        android:fontFamily="@font/josefin_sans"
        android:includeFontPadding="true"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/menuInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_beige"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navInicioMapaAluno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_home" app:tint="@color/unibus_blue" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Início" android:textColor="@color/unibus_blue" android:textSize="12sp" android:textStyle="bold"
        android:fontFamily="@font/josefin_sans"
        android:includeFontPadding="true"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="30dp" android:background="@color/unibus_blue" android:alpha="0.3"/>

        <LinearLayout
            android:id="@+id/navPreferenciasMapaAluno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_menu" app:tint="@color/unibus_blue" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Preferências" android:textColor="@color/unibus_blue" android:textSize="12sp" android:textStyle="bold"
        android:fontFamily="@font/josefin_sans"
        android:includeFontPadding="true"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="30dp" android:background="@color/unibus_blue" android:alpha="0.3"/>

        <LinearLayout
            android:id="@+id/navSuporteMapaAluno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_suport" app:tint="@color/unibus_blue" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Suporte" android:textColor="@color/unibus_blue" android:textSize="12sp" android:textStyle="bold"
        android:fontFamily="@font/josefin_sans"
        android:includeFontPadding="true"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
