<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_beige">

    <ImageView
        android:id="@+id/logoAluno"
        android:layout_width="96dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/unibus_logo"
        android:src="@drawable/logo_unibus_texto"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/headerAluno"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/unibus_blue"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoAluno">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <ImageView
                android:id="@+id/avatarAluno"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:contentDescription="@null"
                android:src="@drawable/avatar_ema_circle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvSaudacaoAluno"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="Olá, Leandro!"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/avatarAluno"
                app:layout_constraintTop_toTopOf="@id/avatarAluno"
        android:includeFontPadding="true"/>

            <TextView
                android:id="@+id/tvMatriculaAluno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="8dp"
                android:text="2121054"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:layout_constraintStart_toEndOf="@id/avatarAluno"
                app:layout_constraintTop_toBottomOf="@id/tvSaudacaoAluno"
        android:includeFontPadding="true"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardAvisosAluno"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/card_gray"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/btnRotasAluno"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerAluno">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avisos"
                android:textColor="@color/text_gray"
                android:textSize="18sp"
                android:textStyle="bold"
        android:includeFontPadding="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Unibus - Rota Indisponível                         24/01/2025\nLorem ipsum dolor sit amet, consectetur adipiscing elit. Proin imperdiet metus nec lacus dictum ultrices."
                android:textColor="@color/text_gray"
                android:textSize="13sp"
        android:includeFontPadding="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/divider_gray" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unibus - Rota Indisponível                         24/01/2025\nLorem ipsum dolor sit amet, consectetur adipiscing elit. Proin imperdiet metus nec lacus dictum ultrices."
                android:textColor="@color/text_gray"
                android:textSize="13sp"
        android:includeFontPadding="true"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/btnRotasAluno"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavAluno"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Rotas"
            android:textColor="@color/unibus_blue"
            android:textSize="18sp"
            android:textStyle="bold"
        android:includeFontPadding="true"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/bottomNavAluno"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/white"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/navInicioAluno"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂ Início"
            android:textColor="@color/unibus_blue"
            android:textSize="13sp"
        android:includeFontPadding="true"/>

        <TextView
            android:id="@+id/navRotasAluno"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="☰ Rotas"
            android:textColor="@color/unibus_blue"
            android:textSize="13sp"
        android:includeFontPadding="true"/>

        <TextView
            android:id="@+id/navSuporteAluno"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="◌ Suporte"
            android:textColor="@color/unibus_blue"
            android:textSize="13sp"
        android:includeFontPadding="true"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
